FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    # Core Ansible and Python
    ansible \
    python3 \
    python3-pip \
    python3-venv \
    python3-full \
    # SSH and remote access
    ssh \
    sshpass \
    openssh-client \
    # Network tools
    curl \
    wget \
    telnet \
    netcat-openbsd \
    dnsutils \
    iputils-ping \
    net-tools \
    # System utilities
    vim \
    nano \
    less \
    tree \
    htop \
    file \
    jq \
    yamllint \
    # Version control
    git \
    # Compression tools
    zip \
    unzip \
    gzip \
    tar \
    # Process monitoring
    procps \
    psmisc \
    # Database clients (optional but useful)
    default-mysql-client \
    postgresql-client \
    sqlite3 \
    # Additional useful packages
    ca-certificates \
    apt-transport-https \
    gnupg \
    lsb-release \
    # Container tools for ansible-navigator
    podman \
    # Build dependencies for Python packages
    build-essential \
    python3-dev \
    libffi-dev \
    libssl-dev \
    libonig-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create a virtual environment for Python packages
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install ansible-navigator and related tools in the virtual environment
RUN /opt/venv/bin/pip install --no-cache-dir \
    wheel \
    && /opt/venv/bin/pip install --no-cache-dir \
    ansible-navigator \
    ansible-builder \
    ansible-runner \
    ansible-lint

# Clean up build dependencies to reduce image size (optional)
RUN apt-get remove -y build-essential python3-dev libffi-dev libssl-dev pkg-config \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Create SSH directory
RUN mkdir -p /root/.ssh

# SSH config for container environment
RUN echo "StrictHostKeyChecking no" > /root/.ssh/config
RUN echo "UserKnownHostsFile /dev/null" >> /root/.ssh/config

# Create useful aliases
RUN echo "alias ll='ls -la'" >> /root/.bashrc
RUN echo "alias l='ls -la'" >> /root/.bashrc
RUN echo "alias ..='cd ..'" >> /root/.bashrc
RUN echo "alias ...='cd ../..'" >> /root/.bashrc

# Add virtual environment to PATH in bashrc
RUN echo 'export PATH="/opt/venv/bin:$PATH"' >> /root/.bashrc

# Create ansible-navigator aliases
RUN echo "alias nav='ansible-navigator'" >> /root/.bashrc
RUN echo "alias an='ansible-navigator'" >> /root/.bashrc

# Create a welcome message
RUN echo "echo '=== Ansible Lab Controller ==='" >> /root/.bashrc
RUN echo "echo 'Available nodes: ubuntu_node, centos_node, alpine_node, rhel_node'" >> /root/.bashrc
RUN echo "echo 'Quick commands:'" >> /root/.bashrc
RUN echo "echo '  ansible all -m ping'" >> /root/.bashrc
RUN echo "echo '  ansible-playbook playbooks/ping.yml'" >> /root/.bashrc
RUN echo "echo '  ansible-navigator run playbooks/ping.yml --ee false'" >> /root/.bashrc
RUN echo "echo '  ansible-navigator --version'" >> /root/.bashrc
RUN echo "echo 'Python packages are installed in virtual environment: /opt/venv'" >> /root/.bashrc

WORKDIR /ansible

CMD ["/bin/bash"]